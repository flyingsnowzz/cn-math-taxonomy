{
  "name": "cnm-server",
  "version": "0.1.0",
  "private": true,
  "description": "中小学知识图谱 · 账号/云同步 API（Express + PostgreSQL，CloudBase 云托管）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts test/integration/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "tencentcloud-sdk-nodejs-sms": "^4.1.306"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
